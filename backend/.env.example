# ============================================
# MERN CTF PLATFORM - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Database Configuration
# ============================================
# MongoDB connection URI (use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ctf-platform?retryWrites=true&w=majority

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing JWT tokens (use a long, random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Token expiration time (example: 7 days)
JWT_EXPIRES_IN=7d

# ============================================
# Server Configuration
# ============================================
# Server port
PORT=5000

# Node environment (development, production, test)
NODE_ENV=production

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS (set to your deployed frontend domain)
# Examples: https://your-domain.com OR https://yourapp.vercel.app
CORS_ORIGIN=https://your-frontend-domain.com

# ============================================
# Admin Registration Security
# ============================================
# Secret token required to create admin accounts
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_REGISTRATION_TOKEN=your-secure-admin-token-change-this

# ============================================
# Security Settings
# ============================================
# Password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# ============================================
# Logging
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
