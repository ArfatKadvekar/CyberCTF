# API Configuration
# Use your backend API URL (e.g., https://api.example.com for production)
VITE_API_URL=https://your-backend-api.com/api

# Development proxy target (for development only, used by Vite dev server)
# Default: http://127.0.0.1:5000
# For production, this is not used (set VITE_API_URL instead)
VITE_API_PROXY=http://127.0.0.1:5000

# Cloudinary Configuration (for file uploads)
# Get these from your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
